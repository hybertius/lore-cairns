{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitepress/client", "vue"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "env.d.ts"]
}
